# Anna University RAG Study Assistant - Backend Environment
PROJECT_NAME="Anna University RAG Study Assistant"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# CORS configuration (allow frontend dev server)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Firebase Configuration
# Path to service account JSON file, or leave blank for local dev mock mode
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""

# Local file storage directory for uploaded PDFs and materials
STORAGE_DIR="./storage_uploads"

# Jina AI Hosted Embeddings
# Get your API key from https://jina.ai/
JINA_API_KEY="your_jina_api_key"
JINA_EMBEDDING_MODEL="jina-embeddings-v5-text-small"
JINA_EMBEDDING_DIMENSIONS=1024

# Vector Store Provider ("qdrant" or "chroma")
VECTOR_STORE_PROVIDER="qdrant"

# Qdrant Vector Database (Docker on localhost:6333 or Qdrant Cloud)
# For local Docker: docker run -p 6333:6333 -p 6334:6334 -v $(pwd)/qdrant_storage:/qdrant/storage qdrant/qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="anna_university_child_chunks_v1"
# Optional Qdrant Cloud Cluster:
# QDRANT_CLUSTER_ENDPOINT="https://your-cluster-id.cloud.qdrant.io"

# Chroma Vector Database (Optional alternative)
CHROMA_API_KEY="your_chroma_cloud_api_key"
CHROMA_TENANT="your_tenant_id"
CHROMA_DATABASE="your_database_name"
CHROMA_COLLECTION_NAME="anna_university_child_chunks_v1"

# LLM Inference Provider Configuration
# Supported providers: "groq" | "lmstudio" | "ollama" | "custom" | "openai" | "gemini"
LLM_PROVIDER="groq"
# For Groq: https://api.groq.com/openai/v1 (model: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
# For Local LM Studio: http://localhost:1234/v1 (model: local-model)
# For Local Ollama: http://localhost:11434/v1 (model: llama3.2)
# For Custom remote server / ngrok: https://your-server-or-tunnel/v1
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="your_groq_or_openai_api_key"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_TEMPERATURE=0.2

# Stage 7: Neural Cross-Encoder Reranker
RERANKER_ENABLED=true
RERANKER_PROVIDER="jina"
RERANKER_MODEL="jina-reranker-v2-base-multilingual"
RERANKER_URL="https://api.jina.ai/v1/rerank"
RERANKER_TOP_N=4

