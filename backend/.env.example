# Anna University RAG Study Assistant - Backend Environment
PROJECT_NAME="Anna University RAG Study Assistant"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# CORS configuration (allow frontend dev server)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Firebase Configuration
# Path to service account JSON file, or leave blank for local dev mock mode
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""

# Local file storage directory for uploaded PDFs and materials
STORAGE_DIR="./storage_uploads"

# Jina AI Hosted Embeddings
# Get your API key from https://jina.ai/
JINA_API_KEY="your_jina_api_key"
JINA_EMBEDDING_MODEL="jina-embeddings-v5-text-small"
JINA_EMBEDDING_DIMENSIONS=1024

# Chroma Cloud Managed Vector Database
# Create database & API key from https://trychroma.com/
CHROMA_API_KEY="your_chroma_cloud_api_key"
CHROMA_TENANT="your_tenant_id"
CHROMA_DATABASE="your_database_name"
CHROMA_COLLECTION_NAME="anna_university_child_chunks_v1"
